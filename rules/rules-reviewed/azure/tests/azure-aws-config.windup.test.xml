<?xml version="1.0" encoding="UTF-8"?>
<ruletest id="azure-aws-config-test"
          xmlns="http://windup.jboss.org/schema/jboss-ruleset"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://windup.jboss.org/schema/jboss-ruleset http://windup.jboss.org/schema/jboss-ruleset/windup-jboss-ruleset.xsd">
    <testDataPath>data/azure-aws-config</testDataPath>
    <rulePath>../azure-aws-config.windup.xml</rulePath>
    <ruleset>
        <rules>
            <rule id="azure-aws-config-test-01000">
                <when>
                    <not>
                        <hint-exists message="The application contains AWS credential configuration"/>
                    </not>
                </when>
                <perform>
                    <fail message="aws-credential-config hint was not found!"/>
                </perform>
            </rule>
            <rule id="azure-aws-config-test-02000">
                <when>
                    <not>
                        <hint-exists message="The application contains AWS region configuration"/>
                    </not>
                </when>
                <perform>
                    <fail message="aws-region-config hint was not found!"/>
                </perform>
            </rule>
            <rule id="azure-aws-config-test-03000">
                <when>
                    <not>
                        <hint-exists message="The application contains AWS S3"/>
                    </not>
                </when>
                <perform>
                    <fail message="aws-S3-config hint was not found!"/>
                </perform>
            </rule>           
            <rule id="azure-aws-config-test-04000">
                <when>
                    <not>
                        <hint-exists message="The application contains dependencies for Amazon Simple Queue Service by using the AWS SDK Java 1.x" />
                    </not>
                </when>
                <perform>
                    <fail message="aws-sqs java 1.x dependency hint was not found!" />
                </perform>
            </rule>
            <rule id="azure-aws-config-test-04001">
                <when>
                    <not>
                        <hint-exists message="The application contains Amazon Simple Queue Service by using the AWS SDK Java 1.x" />
                    </not>
                </when>
                <perform>
                    <fail message="aws-sqs java 2.x api hint was not found!" />
                </perform>
            </rule>
            <rule id="azure-aws-config-test-04002">
                <when>
                    <not>
                        <hint-exists message="The application contains dependencies for Amazon Simple Queue Service by using the AWS SDK Java 2.x" />
                    </not>
                </when>
                <perform>
                    <fail message="aws-sqs java 2.x dependency hint was not found!" />
                </perform>
            </rule>
            <rule id="azure-aws-config-test-04003">
                <when>
                    <not>
                        <hint-exists message="The application contains Amazon Simple Queue Service by using the AWS SDK Java 2.x" />
                    </not>
                </when>
                <perform>
                    <fail message="aws-sqs java 2.x api hint was not found!" />
                </perform>
            </rule>
            <rule id="azure-aws-config-test-04004">
                <when>
                    <not>
                        <hint-exists message="The application contains Amazon Simple Queue Service configuration"/>
                    </not>
                </when>
                <perform>
                    <fail message="aws-sqs-config hint was not found!"/>
                </perform>
            </rule>
            <rule id="azure-aws-config-test-05000">
                <when>
                    <not>
                        <hint-exists message="The application contains AWS Secrets Manager configuration" />
                    </not>
                </when>
                <perform>
                    <fail message="aws-secrets-config hint was not found!" />
                </perform>
            </rule>
        </rules>
    </ruleset>
</ruletest>